# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# Set in .env.local, which is not committed. Run "bin/console campfire:generate-secrets"
# to fill it in, or export the variable in the environment.
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Campfire keeps all state under storage/, like the original Rails app.
DATABASE_URL="sqlite:///%kernel.project_dir%/storage/db/development.sqlite3"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mercure-bundle ###
# The URL of the Mercure hub, used by the app to publish updates (can be a local URL)
MERCURE_URL=http://localhost:8080/.well-known/mercure
# The public URL of the Mercure hub, used by the browser to connect
MERCURE_PUBLIC_URL=http://localhost:8080/.well-known/mercure
# The secret used to sign the JWTs. Like APP_SECRET, it belongs to .env.local
# and "bin/console campfire:generate-secrets" writes it there.
MERCURE_JWT_SECRET=
###< symfony/mercure-bundle ###

###> campfire ###
# Web Push (VAPID). Generate a key pair with: bin/console campfire:vapid-key
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:campfire@localhost

# Displayed in the sidebar footer and used by the admin scripts.
APP_VERSION=
GIT_REVISION=

# Optional error reporting, disabled when empty.
SENTRY_DSN=
SKIP_TELEMETRY=

# Comma separated list, only needed when a reverse proxy sits in front of the app.
TRUSTED_PROXIES=
TRUSTED_HOSTS=
###< campfire ###
