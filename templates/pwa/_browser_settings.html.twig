{#
    How to allow notifications in the browser of the reader.

    The steps are the ones of the browser and the system actually in use, so a
    reader is only shown the menus they have. It is left out for Safari and
    Chrome on an iPhone or an iPad, where notifications are only ever allowed
    from the system settings.
#}
{% set p = platform() %}

{% if not ((p.isSafari or p.isChrome) and p.isIos) %}
    <details class="notifications-help" data-notifications-target="details">
        <summary class="btn">
            <img src="{{ asset('images/external/web.svg') }}" alt="" width="20" height="20">
            <strong>Check your {{ p.browser|capitalize }} settings</strong>
            <img src="{{ asset('images/disclosure.svg') }}" alt="" width="10" height="10" class="disclosure">
        </summary>

        {% if p.isFirefox and p.isAndroid %}
            <ol>
                <li>Tap <em><img src="{{ asset('images/lock.svg') }}" alt="the View site information button" width="20" height="20"></em> in the address bar.</li>
                <li>Tap <em>Notification</em> to change to <em>Allowed</em>.</li>
            </ol>
        {% elseif p.isEdge and p.isDesktop %}
            <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
            <ol>
                <li>Click <em><img src="{{ asset('images/lock.svg') }}" alt="the View site information button" width="20" height="20"></em> left of the address bar.</li>
                <li>Under <em>Permissions for this site &gt; Notifications</em>, choose <em>Allow</em>.</li>
            </ol>

            <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for {{ p.browser|capitalize }}.</h2>
            <ol>
                {% if p.isWindows %}
                    <li>Click <em>Start</em>, then <em>Settings</em>.</li>
                    <li>Go to <em>System &gt; Notification</em>.</li>
                    <li>Click <em><img src="{{ asset('images/external/switch.svg') }}" alt="the switch" width="22" height="22"></em> <em>ON</em> for {{ p.browser|capitalize }}.</li>
                {% else %}
                    <li>Click <em aria-label="the Apple menu">&#63743;</em> in the top left.</li>
                    <li>Click <em>System Settings&#8230;</em>.</li>
                    <li>Click <em>Notifications</em>.</li>
                    <li>Click <em>{{ p.browser|capitalize }}</em>.</li>
                    <li>Click <em><img src="{{ asset('images/external/switch.svg') }}" alt="the switch" width="22" height="22"></em> to <em>Allow notifications</em>.</li>
                {% endif %}
            </ol>
        {% elseif p.isFirefox and p.isDesktop %}
            <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
            <ol>
                <li>Click <em>{{ p.browser|capitalize }}</em> in the top left.</li>
                <li>Click <em>Settings&#8230;</em>.</li>
                <li>Click <em>Privacy &amp; Security</em> in the sidebar.</li>
                <li>Scroll down to <em>Permissions</em>.</li>
                <li>Click <em>Settings</em> next to <em>Notifications</em>.</li>
                <li>Select <em>Allow</em> next to <em>{{ url('root') }}</em>.</li>
            </ol>

            <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for {{ p.browser|capitalize }}.</h2>
            <ol>
                {% if p.isWindows %}
                    <li>Click <em>Start</em>, then <em>Settings</em>.</li>
                    <li>Go to <em>System &gt; Notification</em>.</li>
                    <li>Click <em><img src="{{ asset('images/external/switch.svg') }}" alt="the toggle button" width="22" height="22"></em> <em>ON</em> for {{ p.browser|capitalize }}.</li>
                {% else %}
                    <li>Click <em aria-label="the Apple menu">&#63743;</em> in the top left.</li>
                    <li>Click <em>System Settings&#8230;</em>.</li>
                    <li>Click <em>Notifications</em>.</li>
                    <li>Click <em>{{ p.browser|capitalize }}</em>.</li>
                    <li>Click <em><img src="{{ asset('images/external/switch.svg') }}" alt="the switch" width="22" height="22"></em> to <em>Allow notifications</em>.</li>
                {% endif %}
            </ol>
        {% elseif p.isChrome and p.isDesktop %}
            <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
            <ol>
                <li>Click the <em><img src="{{ asset('images/external/sliders.svg') }}" alt="View site information" width="20" height="20"></em> icon in the address bar.</li>
                <li>Click <em>Site Settings</em>.</li>
                <li>Ensure notifications are <em>Allowed</em>.</li>
            </ol>

            <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for {{ p.browser|capitalize }}.</h2>
            <ol>
                {% if p.isWindows %}
                    <li>Click <em>Start</em>, then <em>Settings</em>.</li>
                    <li>Go to <em>System &gt; Notification</em>.</li>
                    <li>Click <em><img src="{{ asset('images/external/switch.svg') }}" alt="the switch" width="22" height="22"></em> <em>ON</em> for {{ p.browser|capitalize }}.</li>
                {% else %}
                    <li>Click <em aria-label="the Apple menu">&#63743;</em> in the top left.</li>
                    <li>Click <em>System Settings&#8230;</em>.</li>
                    <li>Click <em>Notifications</em>.</li>
                    <li>Click <em>{{ p.browser|capitalize }}</em>.</li>
                    <li>Click <em><img src="{{ asset('images/external/switch.svg') }}" alt="the switch" width="22" height="22"></em> to <em>Allow notifications</em>.</li>
                {% endif %}
            </ol>
        {% elseif p.isChrome and p.isAndroid %}
            <ol>
                <li>Tap the <em><img src="{{ asset('images/menu-dots-vertical.svg') }}" alt="More options" width="16" height="16"></em> menu button.</li>
                <li>Tap <em>Settings</em>.</li>
                <li>Tap <em>Notifications</em>.</li>
                <li>Tap <em><img src="{{ asset('images/external/switch.svg') }}" alt="the switch" width="22" height="22"></em> to <em>Allow {{ p.browser|capitalize }} notifications</em>.</li>
                <li>Tap <em><img src="{{ asset('images/external/switch.svg') }}" alt="the switch" width="22" height="22"></em> next to <em>Web apps</em>.</li>
                <li>Tap <em><img src="{{ asset('images/notification-bell-alert.svg') }}" alt="the notification bell" width="16" height="16"></em> and select <em>Allow</em>.</li>
            </ol>
        {% elseif p.isSafari and p.isDesktop %}
            <ol>
                <li>Click <em>{{ p.browser|capitalize }}</em> in the top left.</li>
                <li>Click <em>Settings&#8230;</em>.</li>
                <li>Click the <em>Websites</em> tab.</li>
                <li>Click <em>Notifications</em> in the sidebar.</li>
                <li>Click <em>{{ url('root') }}</em> in the list.</li>
                <li>Select <em>Allow</em>.</li>
            </ol>
        {% else %}
            <p>Ensure notifications are enabled for <em>{{ url('root') }}</em> in your web browser settings.</p>
        {% endif %}
    </details>
{% endif %}
