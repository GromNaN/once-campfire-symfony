{#
    The web app manifest.

    The name and the icons are the ones of the account, so an installation
    carries the brand of the team that runs it. The sizes are the ones the
    original application declares, which is what browsers ask for when they
    build the home screen icon.
#}
{
    "name": {{ name|json_encode|raw }},
    "icons": [
        {
            "src": {{ path('account_logo_show', { size: 'small' })|json_encode|raw }},
            "type": "image/png",
            "sizes": "192x192"
        },
        {
            "src": {{ path('account_logo_show')|json_encode|raw }},
            "type": "image/png",
            "sizes": "512x512"
        },
        {
            "src": {{ path('account_logo_show')|json_encode|raw }},
            "type": "image/png",
            "sizes": "512x512",
            "purpose": "maskable"
        }
    ],
    "start_url": "/",
    "display": "standalone",
    "scope": "/",
    "description": "A chat app from the makers of Basecamp and HEY.",
    "categories": ["social", "business", "productivity"],
    "theme_color": "#ffffff",
    "background_color": "#ffffff",
    "shortcuts": [
        {
            "name": "New chat room",
            "description": "Open Campfire and start a new chat room",
            "url": {{ path('rooms_open_new')|json_encode|raw }}
        },
        {
            "name": "My profile",
            "description": "Open Campfire and view your profile",
            "url": {{ path('user_profile_show')|json_encode|raw }}
        }
    ]
}
