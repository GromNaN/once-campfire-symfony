{#
    How to install the application as a web app.

    Some systems only deliver notifications to an installed application, so a
    reader whose notifications are refused is offered the install steps of
    their own browser. Chrome and desktop Firefox install from the address bar
    themselves, so they are left out.
#}
{% set p = platform() %}

{% if not (p.isChrome or (p.isFirefox and not p.isAndroid)) %}
    <details class="notifications-help pwa__instructions hide-in-pwa"
             data-controller="pwa-install"
             data-pwa-install-prompting-class="pwa--can-install"
             data-notifications-target="details">
        <summary class="btn">
            <img src="{{ asset('images/external/install.svg') }}" alt="" width="20" height="20">
            <strong>Install Campfire as a web app.</strong>
            <img src="{{ asset('images/disclosure.svg') }}" alt="" width="10" height="10" class="disclosure">
        </summary>

        {% if p.isEdge %}
            <ol>
                <li>Click <em><img src="{{ asset('images/external/install-edge.svg') }}" alt="the app available - install Campfire chat button" width="16" height="16"></em>in the address bar.</li>
                <li>Click <em>Install</em>.</li>
            </ol>
        {% elseif p.isChrome and p.isAndroid %}
            <ol>
                <li>Tap the <em><img src="{{ asset('images/menu-dots-vertical.svg') }}" alt="More options" width="16" height="16"></em> menu button.</li>
                <li>Tap <em>Install app</em> in the menu.</li>
            </ol>
        {% elseif p.isFirefox and p.isAndroid %}
            <ol>
                <li>Tap the <em><img src="{{ asset('images/menu-dots-vertical.svg') }}" alt="More options" width="16" height="16"></em> menu button.</li>
                <li>Tap <em>Install</em> in the menu.</li>
            </ol>
        {% elseif p.isSafari and p.isDesktop %}
            <ol>
                <li>Click <em>File</em> in the top left.</li>
                <li>Click <em>Add to Dock&#8230;</em>.</li>
            </ol>
        {% elseif (p.isSafari or p.isChrome) and p.isIos %}
            <p>To receive push notifications in {{ p.browser|capitalize }} for {{ p.operatingSystem }}, you must install Campfire as a web app.</p>
            <ol>
                <li>Tap <em><img src="{{ asset('images/external/share.svg') }}" alt="the share button" width="20" height="20"></em></li>
                <li>Tap <em>Add to Home Screen</em>.</li>
            </ol>
        {% else %}
            <p>Some platforms require you to install Campfire as a web app to receive push notifications.</p>
        {% endif %}

        <div class="margin-block-start txt-align-center pwa__installer">
            <hr class="separator margin-block">
            <button class="btn btn--reversed center" data-action="pwa-install#promptInstall">
                <img src="{{ asset('images/external/install.svg') }}" alt="">
                Install now
            </button>
        </div>
    </details>
{% endif %}
