{#
    Layout of the signed in pages.

    Every page listens to the hub, and the sidebar is a permanent Turbo Frame
    that survives a navigation and is refreshed on its own when the room list
    changes. A page that has no sidebar leaves the block empty.
#}
{% extends 'base.html.twig' %}

{% block body_class %}sidebar{% endblock %}

{% block stream_source %}
    {# The address names the topics of the reader, and the connection is
       private: the subscriber cookie minted with the response is what grants
       those topics, and nothing else. #}
    <turbo-mercure-stream-source src="{{ mercure_subscribe_url() }}" private></turbo-mercure-stream-source>
{% endblock %}

{% block body %}
    {# A page fills either the body of the page or its main area, whichever
       reads better for what it holds. #}
    {% block main %}{% endblock %}
{% endblock %}

{% block sidebar %}
    <aside id="sidebar" data-controller="toggle-class" data-toggle-class-toggle-class="open">
        <turbo-frame id="user_sidebar" src="{{ path('users_sidebar') }}" target="_top"
                     data-turbo-permanent data-controller="rooms-list">
            <div class="sidebar__container"></div>
        </turbo-frame>
    </aside>
{% endblock %}
