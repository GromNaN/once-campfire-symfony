{#
    The page that edits a chat bot, and the two actions that retire it or hand
    it a new key.
#}
{% extends 'layout.html.twig' %}

{% block title %}Edit bot{% endblock %}

{% block nav %}
    <div class="flex-item-justify-start">
        {{ include('layouts/_back_link.html.twig', { url: path('account_bots_index') }) }}
    </div>
{% endblock %}

{% block body %}
    <section class="panel" style="view-transition-name: chat-bot-{{ bot.id }}">
        {{ form_start(form, { attr: { class: 'flex flex-column gap' } }) }}
            {{ include('accounts/bots/_form.html.twig', { form: form, bot: bot }) }}
        {{ form_end(form) }}

        <hr class="separator full-width margin-block-double">

        <div class="flex align-center gap justify-space-between">
            <form action="{{ path('account_bot_destroy', { id: bot.id }) }}" method="post"
                  data-turbo-confirm="Are you sure you want to permanently remove this bot from the account? This can't be undone.">
                <input type="hidden" name="_method" value="DELETE">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('account_bot_destroy') }}">

                <button type="submit" class="btn txt--small btn--negative">
                    <img src="{{ asset('images/trash.svg') }}" alt="" width="20" height="20">
                    <img src="{{ asset('images/bot.svg') }}" alt="" width="20" height="20">
                    <span class="for-screen-reader">Delete this chat bot</span>
                </button>
            </form>

            <form action="{{ path('account_bot_key_update', { bot_id: bot.id }) }}" method="post"
                  data-turbo-confirm="Are you sure you want to change the bot key? All usage of this bot must be updated.">
                <input type="hidden" name="_method" value="PUT">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('account_bot_key_update') }}">

                <button type="submit" class="btn full-width txt--small btn--negative">
                    <img src="{{ asset('images/refresh.svg') }}" alt="" width="20" height="20">
                    <img src="{{ asset('images/key.svg') }}" alt="" width="20" height="20">
                    <span class="for-screen-reader">Generate a new key</span>
                </button>
            </form>
        </div>
    </section>
{% endblock %}
