{#
    The box that narrows a long list of people down while it is typed in.

    It is only shown when the list is long enough to be worth searching, and the
    list it filters carries the names it is looked up by.
#}
<input type="search" id="search" autocorrect="off" autocomplete="off" data-1p-ignore="true"
       class="input input--transparent full-width" placeholder="Filter..." data-action="input->filter#filter">
