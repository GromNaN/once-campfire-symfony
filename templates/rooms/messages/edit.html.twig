{#
    The editor of a message, shown in place of the message itself.

    It replaces the body of the message inside its own Turbo Frame, so opening
    it leaves the rest of the conversation alone. A message that carries a file
    has nothing to rewrite, so it only offers to delete it.

    The delete button belongs to a form of its own, which is what lets it sit
    beside the save button while posting somewhere else.
#}
{% set attachment = message_attachment(message) %}
{% set delete_form_id = 'delete_form_message_' ~ message.id %}
{% set confirm = 'Are you sure you want to delete this message?' %}

<turbo-frame id="edit_message_{{ message.id }}">
    <div class="message__body position-relative" data-controller="scroll-into-view">
        <div class="message__body-content message__body-content--editing gap">
            {% if attachment %}
                {{ include('rooms/messages/_attachment.html.twig', { blob: attachment }) }}

                <div class="message__edit-btns flex align-center justify-space-between gap full-width pad-block-start-half">
                    <button type="submit" class="btn btn--negative center margin-block-end"
                            form="{{ delete_form_id }}" data-turbo-confirm="{{ confirm }}">
                        <img src="{{ asset('images/trash.svg') }}" alt="">
                        <span class="for-screen-reader">Delete message</span>
                    </button>
                </div>
            {% else %}
                <div class="composer--edit composer--rich-text">
                    {{ form_start(form, {
                        action: path('rooms_messages_update', { room_id: room.id, id: message.id }),
                        attr: {
                            id: 'edit_message_form_' ~ message.id,
                            'data-controller': 'form',
                            'data-action': 'keydown.esc->form#cancel keydown.ctrl+enter->form#submit:prevent keydown.meta+enter->form#submit:prevent',
                            'data-turbo-stream': 'true',
                        },
                    }) }}
                        <div class="full-width input input--actor min-width fill-white">
                            {{ form_widget(form.body, { attr: {
                                class: 'input',
                                rows: 1,
                                'aria-label': 'Edit message',
                                autofocus: true,
                            } }) }}
                        </div>

                        {# The escape key follows this link, which brings the
                           message back in place of the editor. #}
                        <a href="{{ path('rooms_messages_show', { room_id: room.id, id: message.id }) }}"
                           data-form-target="cancel" hidden>Close editor and discard changes</a>

                        <div class="message__edit-btns flex align-center justify-space-between gap full-width pad-block-start-half">
                            <button type="submit" class="btn btn--reversed">
                                <img src="{{ asset('images/check.svg') }}" alt="">
                                <span class="for-screen-reader">Save changes</span>
                            </button>

                            <button type="submit" class="btn btn--negative"
                                    form="{{ delete_form_id }}" data-turbo-confirm="{{ confirm }}">
                                <img src="{{ asset('images/trash.svg') }}" alt="">
                                <span class="for-screen-reader">Delete message</span>
                            </button>
                        </div>

                        {# The editor only rewrites the body, so the fields the
                           composer needs are left out rather than drawn. #}
                        {% do form.attachment.setRendered %}
                        {% do form.clientMessageId.setRendered %}
                    {{ form_end(form) }}
                </div>
            {% endif %}
        </div>

        <div class="message__actions flex flex-wrap">
            <a href="{{ path('rooms_messages_show', { room_id: room.id, id: message.id }) }}"
               class="message__action-btn message__edit-close-btn txt-small btn btn--borderless">
                <img src="{{ asset('images/remove.svg') }}" alt="" class="colorize--black">
                <span class="for-screen-reader">Close editor and discard changes</span>
            </a>
        </div>

        <form action="{{ path('rooms_messages_destroy', { room_id: room.id, id: message.id }) }}" method="post"
              id="{{ delete_form_id }}" data-turbo-stream="true">
            <input type="hidden" name="_method" value="DELETE">
        </form>
    </div>
</turbo-frame>
