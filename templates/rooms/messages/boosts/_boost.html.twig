{#
    A boost, identified by its own row id so that the broadcast can take it back
    out of the list. Only the person who added it can remove it, which the
    controller enforces; the button is shown to everyone, like the original.
#}
<div id="boost_{{ boost.id }}"
     class="boost boost-item flex-inline postion--relative max-width align-center fill-white gap"
     data-controller="boost-delete"
     data-boost-delete-perform-class="boost--deleting"
     data-boost-delete-reveal-class="expanded"
     data-boost-delete-booster-id-value="{{ boost.booster.id }}">
    <figure class="avatar boost__avatar flex-item-no-shrink">
        <img src="{{ avatar_path(boost.booster) }}" alt="" width="20" height="20"
             aria-label="{{ boost.booster.name }} boosted {{ boost.content }}">
    </figure>

    <span class="txt-small" role="button"
          data-action="click->boost-delete#reveal keydown.enter->boost-delete#reveal:prevent"
          data-boost-delete-target="content">{{ boost.content }}</span>

    <form action="{{ path('messages_boosts_destroy', { message_id: message.id, id: boost.id }) }}" method="post">
        <input type="hidden" name="_method" value="DELETE">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('messages_boosts_destroy') }}">

        <button type="submit" class="btn btn--negative flex-item-justify-end boost__delete"
                data-action="boost-delete#perform" data-boost-delete-target="button">
            <img src="{{ asset('images/minus.svg') }}" alt="" width="20" height="20">
            <span class="for-screen-reader">Delete this boost</span>
        </button>
    </form>
</div>
