{#
    One row of the list of people of a closed room.

    The switch grants or revokes access. The person creating the room is always
    in it, so their row carries the value without a switch to turn it off.
#}
<li class="flex align-center gap margin-none" data-value="{{ row.user.name|lower }}">
    <figure class="avatar flex-item-no-shrink" style="--avatar-size: 4ch;">
        <a href="{{ path('user_show', { id: row.user.id }) }}" title="{{ row.user.title }}" class="btn avatar"
           data-turbo-frame="_top">
            <img src="{{ avatar_path(row.user) }}" alt="" width="48" height="48" loading="lazy">
        </a>
    </figure>

    <div class="min-width">
        <div class="overflow-ellipsis fill-shade"><strong>{{ row.user.name }}</strong></div>
    </div>

    <hr class="separator" aria-hidden="true">

    {% if can_administer %}
        {% if forced %}
            <input type="hidden" name="{{ row.field.vars.full_name }}" value="{{ row.user.id }}">
            <img src="{{ asset('images/check.svg') }}" width="20" height="20"
                 class="colorize--black flex-item-no-shrink" alt="">
        {% else %}
            <label class="switch flex-item-no-shrink">
                {{ form_widget(row.field, { attr: { class: 'switch__input' } }) }}
                <span class="switch__btn round"></span>
                <span class="for-screen-reader">Give {{ row.user.name }} access to this room</span>
            </label>
        {% endif %}
    {% endif %}
</li>
