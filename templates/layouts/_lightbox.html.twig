{#
    The full screen viewer for a picture.

    It sits on every page and stays empty until a picture is clicked, which is
    what the lightbox controller watches for. The download and share buttons
    follow whatever picture is shown.
#}
<dialog class="lightbox" aria-label="Image Viewer (Press escape to close)" data-lightbox-target="dialog" data-action="close->lightbox#reset">
    <img src="" alt="" class="lightbox__image" data-lightbox-target="zoomedImage">

    <form method="dialog" class="lightbox__btn">
        <button class="btn">
            <img src="{{ asset('images/remove.svg') }}" alt="" width="20" height="20">
            <span class="for-screen-reader">Close image viewer</span>
        </button>
    </form>

    <a href="" class="lightbox__btn--download btn hide-in-ios-pwa" data-lightbox-target="download">
        <img src="{{ asset('images/download.svg') }}" alt="" width="20" height="20">
        <span class="for-screen-reader">Download file</span>
    </a>

    <button type="button" class="lightbox__btn--share btn"
            data-controller="share" data-action="share#share" data-share-value="">
        <img src="{{ asset('images/share.svg') }}" alt="" width="20" height="20">
        <span class="for-screen-reader">Share file</span>
    </button>
</dialog>
