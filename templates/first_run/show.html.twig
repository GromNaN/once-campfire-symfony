{#
    The page that sets up the account.

    It is written on a name tag, which is what the account is: a name, a picture
    and the person who owns it. The form is the only thing on the page, so it
    carries the whole card.
#}
{% extends 'base.html.twig' %}

{% block title %}Set up Campfire{% endblock %}
{% block body_class %}signup{% endblock %}

{% block body %}
    {{ form_start(form, { attr: { class: 'center max-width' } }) }}
        <section class="nametag u-relative">
            <div class="flex justify-center align-center pad-block">
                <img src="{{ asset('images/lanyard.svg') }}" alt="" class="nametag__lanyard">
            </div>

            <div class="nametag__inner flex flex-column gap">
                <fieldset class="flex flex-column center-block">
                    <legend class="txt-large txt-align-center"><strong>Set up Campfire</strong></legend>

                    {% include 'layouts/_avatar_field.html.twig' with {
                        field: form.avatar,
                        src: asset('images/default-avatar.svg'),
                        label: 'Add your avatar',
                    } %}
                </fieldset>

                <div class="flex align-center gap">
                    {{ translation_button('user_name') }}
                    <label class="flex align-center gap flex-item-grow txt-large input input--actor">
                        {{ form_widget(form.name, { attr: {
                            class: 'input',
                            placeholder: 'Name',
                            autocomplete: 'name',
                            autofocus: true,
                            'data-1p-ignore': 'true',
                        } }) }}
                        <img src="{{ asset('images/person.svg') }}" alt="" width="24" height="24" class="colorize--black">
                    </label>
                </div>

                <div class="flex align-center gap">
                    {{ translation_button('email_address') }}
                    <label class="flex align-center gap flex-item-grow txt-large input input--actor">
                        {{ form_widget(form.emailAddress, { attr: {
                            class: 'input',
                            placeholder: 'Email address',
                            autocomplete: 'username',
                        } }) }}
                        <img src="{{ asset('images/email.svg') }}" alt="" width="24" height="24" class="colorize--black">
                    </label>
                </div>

                <div class="flex align-center gap">
                    {{ translation_button('password') }}
                    <label class="flex align-center gap flex-item-grow txt-large input input--actor">
                        {{ form_widget(form.password, { attr: {
                            class: 'input',
                            placeholder: 'Password',
                            autocomplete: 'new-password',
                            maxlength: 72,
                        } }) }}
                        <img src="{{ asset('images/password.svg') }}" alt="" width="24" height="24" class="colorize--black">
                    </label>
                </div>

                <button type="submit" class="btn btn--reversed center txt-large">
                    <img src="{{ asset('images/arrow-right.svg') }}" alt="">
                    <span class="for-screen-reader">Save</span>
                </button>
            </div>
        </section>
    {{ form_end(form) }}
{% endblock %}
